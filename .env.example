# Copy this file to .env.local and fill in real values (never commit .env.local).
# See README.md > "ตั้งค่า Google Sheets API" for how to get these.

GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key including the BEGIN/END lines, wrapped in quotes.
# Keep the \n escape sequences as-is - the app converts them back to real newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
